<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Unze London</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="admin-layout">
    <aside class="admin-sidebar">
      <h2>Unze Admin</h2>
      <a href="/admin" class="active">Dashboard</a>
      <a href="/admin/products/add">Add Product</a>
      <a href="/products">View Store</a>
      <form action="/logout" method="POST">
        <button type="submit" class="logout-btn">Logout</button>
      </form>
    </aside>

    <main class="admin-main">
      <div class="admin-header">
        <div>
          <h1>Product Dashboard</h1>
          <p>Manage products from MongoDB without opening Atlas.</p>
        </div>
        <a href="/admin/products/add" class="primary-btn">+ Add Product</a>
      </div>

      <% if (successMessages && successMessages.length) { %>
        <% successMessages.forEach(message => { %><div class="admin-flash success"><%= message %></div><% }) %>
      <% } %>
      <% if (errorMessages && errorMessages.length) { %>
        <% errorMessages.forEach(message => { %><div class="admin-flash error"><%= message %></div><% }) %>
      <% } %>

      <section class="stats-grid">
        <div class="stat-card">
          <span>Total Products</span>
          <strong><%= totalProducts %></strong>
        </div>
        <div class="stat-card">
          <span>Total Stock</span>
          <strong><%= totalStock %></strong>
        </div>
        <div class="stat-card">
          <span>Categories</span>
          <strong><%= totalCategories %></strong>
        </div>
      </section>

      <section class="table-card">
        <h2>All Products</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Rating</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (products.length === 0) { %>
                <tr>
                  <td colspan="7" class="empty-row">No products found.</td>
                </tr>
              <% } %>

              <% products.forEach(product => { %>
                <tr>
                  <td><img src="<%= product.image %>" alt="<%= product.name %>" class="table-img"></td>
                  <td><%= product.name %></td>
                  <td><%= product.category %></td>
                  <td>PKR <%= product.price.toLocaleString() %></td>
                  <td><%= product.stock %></td>
                  <td><%= product.rating %> ★</td>
                  <td class="action-cell">
                    <a href="/admin/products/edit/<%= product._id %>" class="edit-btn">Edit</a>
                    <form action="/admin/products/delete/<%= product._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this product?');">
                      <button type="submit" class="delete-btn">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>
</body>
</html>
