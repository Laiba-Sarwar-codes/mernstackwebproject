<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register - Unze London</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="auth-page">
    <form class="auth-card" action="/register" method="POST">
      <a href="/" class="auth-logo">Unze London</a>
      <h1>Create Account</h1>
      <p>Customers can register normally. Admin registration requires the secret admin code, and all roles are stored in MongoDB.</p>

      <% if (successMessages && successMessages.length) { %>
        <% successMessages.forEach(message => { %><div class="flash success"><%= message %></div><% }) %>
      <% } %>
      <% if (errorMessages && errorMessages.length) { %>
        <% errorMessages.forEach(message => { %><div class="flash error"><%= message %></div><% }) %>
      <% } %>

      <label>Register As</label>
      <select name="role" id="roleSelect" required>
        <option value="customer" <%= (formData.role || 'customer') === 'customer' ? 'selected' : '' %>>Customer</option>
        <option value="admin" <%= formData.role === 'admin' ? 'selected' : '' %>>Admin</option>
      </select>

      <div id="adminCodeBox" class="admin-code-box">
        <label>Admin Secret Code</label>
        <input type="password" name="adminSecretCode" placeholder="Required only for admin registration">
        <small>Only users with the secret code can create admin accounts.</small>
      </div>

      <label>Name</label>
      <input type="text" name="name" value="<%= formData.name || '' %>" placeholder="Your name" required>

      <label>Email</label>
      <input type="email" name="email" value="<%= formData.email || '' %>" placeholder="Your email" required>

      <label>Password</label>
      <input type="password" name="password" placeholder="Minimum 6 characters" required minlength="6">

      <label>Confirm Password</label>
      <input type="password" name="confirmPassword" placeholder="Confirm password" required minlength="6">

      <button type="submit">Register</button>

      <p class="auth-link">Already have an account? <a href="/login">Login</a></p>
      <p class="auth-link"><a href="/products">Back to products</a></p>
    </form>
  </main>

  <script>
    const roleSelect = document.getElementById('roleSelect');
    const adminCodeBox = document.getElementById('adminCodeBox');

    function toggleAdminCode() {
      adminCodeBox.style.display = roleSelect.value === 'admin' ? 'block' : 'none';
    }

    roleSelect.addEventListener('change', toggleAdminCode);
    toggleAdminCode();
  </script>
</body>
</html>
