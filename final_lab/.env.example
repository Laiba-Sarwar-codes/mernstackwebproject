MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/LAB_FINAL?retryWrites=true&w=majority&appName=unzelondon
PORT=3000
SESSION_SECRET=replace-with-a-random-secret

# Pre-created admin account. The app creates/updates this admin on startup.
ADMIN_EMAIL=admin@unzelondon.com
ADMIN_PASSWORD=admin123

# Required when someone selects "Admin" on the public register page.
# Change this before showing the project publicly.
ADMIN_SECRET_CODE=admin-secret-123

# JWT API authentication. Use a long random value in real projects.
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN=1h
