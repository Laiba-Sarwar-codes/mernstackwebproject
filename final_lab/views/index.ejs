<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>unze london</title>

  <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"/>
</head>

<body>

<header>
    <div class="main-panel">
        <div class="left-panel">
            <div class="menue" id="hamburger"></div>
        </div>

        <div class="logo"></div>

        <div class="right-panel">
            <div class="search"></div>
            <a href="/checkout" class="shoppingcart" title="Checkout"></a>
            <div class="auth-nav">
                    <% if (currentUser) { %>
                        <a href="/profile">My Profile</a>
                        <% if (currentUser.role === "admin") { %><a href="/admin">Admin</a><% } %>
                        <form action="/logout" method="POST"><button type="submit">Logout</button></form>
                    <% } else { %>
                        <a href="/login">Login</a>
                        <a href="/register">Register</a>
                    <% } %>
                  </div>
        </div>
    </div>

    <nav class="top-nav">
        <div class="navbar" id="navbar">
            <a href="/products">VIEW ALL</a>
            <a href="/products?category=Sandals">SANDALS</a>
            <a href="/products?category=Slippers">SLIPPERS</a>
            <a href="/products?category=Courts">COURTS</a>
            <a href="/products?category=Comfort">COMFORT</a>
            <a href="/products?category=Khussa">KHUSSA</a>
            <a href="/products?category=Moccasins">MOCCASINS</a>
            <a href="/products?category=Ballerinas">BALLERINAS</a>
        </div>
    </nav>
</header>

<% if (successMessages && successMessages.length) { %>
  <div class="page-flashes"><% successMessages.forEach(message => { %><div class="flash success"><%= message %></div><% }) %></div>
<% } %>
<% if (errorMessages && errorMessages.length) { %>
  <div class="page-flashes"><% errorMessages.forEach(message => { %><div class="flash error"><%= message %></div><% }) %></div>
<% } %>

<main>
    <div class="hero-section">
        <div class="shoes-section">

            <div class="image-box1">
                <p>ENOLA</p>
                <div class="image-styling" style="background-image:url('/images/image1.webp')"></div>
            </div>

            <div class="image-box2">
                <p>ENOLA</p>
                <div class="image-styling" style="background-image:url('/images/image2.webp')"></div>
            </div>

            <div class="image-box1">
                <p>ENOLA</p>
                <div class="image-styling" style="background-image:url('/images/image3.webp')"></div>
            </div>

            <div class="image-box1">
                <p>ENOLA</p>
                <div class="image-styling" style="background-image:url('/images/image4.webp')"></div>
            </div>

            <div class="image-box1">
                <p>ENOLA</p>
                <div class="image-styling" style="background-image:url('/images/image5.webp')"></div>
            </div>

            <div class="image-box1">
                <p>ENOLA</p>
                <div class="image-styling" style="background-image:url('/images/image6.webp')"></div>
            </div>

            <div class="image-box1">
                <p>ENOLA</p>
                <div class="image-styling" style="background-image:url('/images/image7.webp')"></div>
            </div>

            <div class="image-box1">
                <p>ENOLA</p>
                <div class="image-styling" style="background-image:url('/images/image8.webp')"></div>
            </div>

        </div>
    </div>
</main>

<footer>
    <div class="email-section">
        <p class="email-heading">GET THE LATEST TRENDS FIRST</p>
        <p class="email-sub">Email address</p>

        <div class="email-bar">
            <input type="text">
            <span>→</span>
        </div>
    </div>

    <div class="socials-section">
        <i class="fa-brands fa-facebook"></i>
        <i class="fa-brands fa-youtube"></i>
        <i class="fa-brands fa-instagram"></i>
        <i class="fa-brands fa-tiktok"></i>
    </div>

    <div class="footer-main">
        <div class="footer-col">
            <p class="footer-heading">Store Locator</p>
        </div>

        <div class="footer-col">
            <p class="footer-heading">Customer Help</p>
            <p>Contact Us</p>
            <p>Shipping Information/Delivery</p>
            <p>Privacy Policy</p>
            <p>FAQ's</p>
            <p>Careers</p>
        </div>

        <div class="footer-col">
            <p class="footer-heading">Customer Service</p>
            <p>Store Locator</p>
            <p>Check Your Order Status</p>
            <p>Refund/Return Policy</p>
            <p>My Account</p>
            <p>Share Your Feedback</p>
        </div>

        <div class="footer-col">
            <p class="footer-heading">Useful Info</p>
            <p>About Us</p>
            <p>Promotions</p>
            <p>Open A Franchise</p>
            <p>Pay with Credit/Debit Card</p>
            <p>Order Cancellation</p>
        </div>

        <div class="footer-col">
            <p class="footer-heading">Countries</p>
            <p>Unze PK</p>
            <p>Unze UK</p>
            <p>Unze US</p>
            <p>Unze Germany</p>
            <p>Unze France</p>
        </div>
    </div>

    <div class="footer-bottom">
        <p>Copyright © 2026 Unze London</p>
    </div>
</footer>

<script src="/script.js"></script>
</body>
</html>